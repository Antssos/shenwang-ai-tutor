HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
DATABASE_PATH=./data/wangxueban.sqlite
# Generate a new random invitation value (at least 12 characters).
INVITE_CODE=
COOKIE_SECURE=false
# disabled allows account/history use without model credentials; test is loopback-only and never production.
AI_PROVIDER=disabled
MODEL_API_BASE=https://api.deepseek.com/v1
MODEL_API_KEY=
MODEL_NAME=
EMBEDDING_API_BASE=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
MAX_INPUT_LENGTH=1000
MAX_OUTPUT_TOKENS=1024
DAILY_REQUESTS=100
DAILY_TOKEN_BUDGET=1000000
GLOBAL_DAILY_TOKEN_BUDGET=2000000
MAX_CONCURRENT=2
REQUEST_TIMEOUT_MS=90000
RETENTION_DAYS=90

# Empty for direct/SSH access. Configure exact ingress IPs only after it overwrites X-Real-IP.
TRUSTED_PROXY_IPS=
