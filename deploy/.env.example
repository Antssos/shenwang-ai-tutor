DIFY_API_BASE=http://host.docker.internal/v1
DIFY_API_KEY=

# 只允许正式前端域名；如需本地联调，可追加 http://127.0.0.1:4173。
ALLOWED_ORIGINS=https://xueban.ants.ink
HOST=0.0.0.0
PORT=3000

MAX_INPUT_LENGTH=1000
MAX_REQUEST_BODY_BYTES=16384
REQUESTS_PER_MINUTE=10
REQUESTS_PER_DAY=100
FIRST_BYTE_TIMEOUT_MS=30000
UPSTREAM_TIMEOUT_MS=120000
ANONYMIZATION_SECRET=
INVITE_CODE=
DATABASE_PATH=/data/wangxueban.sqlite
SESSION_COOKIE_NAME=wangxueban_session
SESSION_TTL_HOURS=168
COOKIE_SECURE=true
