# Dify Service API。真实值只放在本地或服务器环境变量中。
DIFY_API_BASE=http://127.0.0.1:8080/v1
DIFY_API_KEY=

# 只允许指定前端访问；多个地址用英文逗号分隔。
ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
HOST=127.0.0.1
PORT=3000

MAX_INPUT_LENGTH=1000
MAX_REQUEST_BODY_BYTES=16384
REQUESTS_PER_MINUTE=10
REQUESTS_PER_DAY=100
FIRST_BYTE_TIMEOUT_MS=30000
UPSTREAM_TIMEOUT_MS=120000
ANONYMIZATION_SECRET=
INVITE_CODE=
DATABASE_PATH=./data/wangxueban.sqlite
SESSION_COOKIE_NAME=wangxueban_session
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
